# Sample configuration only. The credential values below are placeholders.
# Copy this file to finrag/.env and replace placeholders with your own values.
# Keep real API keys, private endpoints, and other secrets only in .env.
OPENAI_API_KEY=your_openai_api_key_here
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Optional custom model provider. Replace the sample host/key before enabling.
# FINRAG_LLM_BASE_URL=https://your-provider.example/v1
# FINRAG_LLM_API_KEY=your_provider_api_key_here

# LangSmith run tracing (set true and add a LangSmith API key to enable).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=sample-project
# Optional self-hosted endpoint; replace this sample host before enabling.
# LANGSMITH_ENDPOINT=https://your-langsmith-host.example

FINRAG_INDEX_VERSION=phase1-v2
FINRAG_LLM_MODEL=gpt-4o-mini
# Optional evidence selection, synthesis and audit model; defaults to FINRAG_LLM_MODEL.
# FINRAG_EVIDENCE_MODEL=
FINRAG_OPENAI_REQUEST_TIMEOUT_SECONDS=30
FINRAG_OPENAI_MAX_RETRIES=1
# Estimated chat-token cost shown by the FastAPI web app. Prices are USD per 1M
# tokens and must match FINRAG_LLM_PRICING_MODEL.
FINRAG_LLM_PRICING_MODEL=gpt-4o-mini
FINRAG_LLM_INPUT_USD_PER_1M=0.15
FINRAG_LLM_CACHED_INPUT_USD_PER_1M=0.075
FINRAG_LLM_OUTPUT_USD_PER_1M=0.60
FINRAG_SEMANTIC_FALLBACK_ENABLED=false
FINRAG_SEMANTIC_FALLBACK_MODEL=gpt-4o-mini
FINRAG_SEMANTIC_FALLBACK_TIMEOUT_SECONDS=10
FINRAG_EMBEDDING_MODEL=text-embedding-3-small
FINRAG_EMBEDDING_DIMENSIONS=1536
FINRAG_MIN_DENSE_SCORE=0.30
FINRAG_MIN_LEXICAL_COVERAGE=0.34
FINRAG_MAX_CONTEXT_TOKENS=12000
FINRAG_MAX_CONCURRENT_REQUESTS=4
FINRAG_REQUEST_DEADLINE_SECONDS=120
# Optional provider rate; unset means embedding cost is reported as unknown.
# FINRAG_EMBEDDING_INPUT_USD_PER_MILLION=
FINRAG_DEBUG_TRACES=false
# Maximum model/tool turns allowed by the LangGraph recursion limit.
FINRAG_AGENT_MAX_ACTIONS=8
FINRAG_API_INDEX_VERSIONS=phase1-v2
FINRAG_CORS_ORIGINS=

# Enable only after replacing the sample Cohere key with your own key.
FINRAG_RERANK_ENABLED=false
FINRAG_RERANK_PROVIDER=cohere
FINRAG_RERANK_MODEL=rerank-v4.0-fast
FINRAG_RERANK_TOP_N_PER_GROUP=4
FINRAG_RERANK_TIMEOUT_SECONDS=15
COHERE_API_KEY=your_cohere_api_key_here
FINRAG_COMPRESSION_ENABLED=true
FINRAG_COMPRESSION_KEEP_BLOCKS=6
